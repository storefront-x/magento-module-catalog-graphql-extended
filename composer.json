{
    "name": "storefront-x/magento-module-catalog-graphql-extended",
    "description": "Magento 2 module - Catalog GraphQL Extension for Magento GraphQL module",
    "type": "magento2-module",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require": {
        "php": ">=7.4",
        "magento/framework": "^103.0.2",
	    "magento/module-graph-ql": "^100.4.2",
	    "magento/module-configurable-product-graph-ql": "^100.4.2",
	    "magento/module-catalog-graph-ql": "100.4.*"
    },
    "license": [
        "MIT"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "StorefrontX\\CatalogGraphQlExtended\\": ""
        }
    },
    "require-dev": {
        "bitexpert/phpstan-magento": "^0.44",
        "magento/magento-coding-standard": "^41",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1"
    }
}
